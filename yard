        "--rm",
        f"--user={uid}:{gid}",
        f"--volume={workdirs.cargo}:/cargo:rw",
        f"--volume={workdirs.rustup}:/rustup:ro",
        f"--volume={crate_dirs.src}:/src:ro",
        "--workdir=/src",
        args.docker_image,
    ]
    env = [
        "/usr/bin/env",
        "-i",
        "CARGO_HOME=/cargo",
        "RUSTUP_HOME=/rustup",
        "PATH=/cargo/bin:/usr/bin",
    ]
    cargo = ["cargo", "fetch", "--locked", f"--target={target}"]
    subprocess.run(docker + env + cargo, check=True)


