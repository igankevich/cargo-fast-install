def cargo_metadata_binaries(
    workdirs: WorkDirs, crate_dirs: CrateDirs, uid: int, gid: int, args: Namespace
) -> list[str]:
    docker = [
        "docker",
        "run",
        "--rm",
        f"--user={uid}:{gid}",
        f"--volume={workdirs.cargo}:/cargo:ro",
        f"--volume={workdirs.rustup}:/rustup:ro",
        f"--volume={crate_dirs.src}:/src:ro",
        f"--volume={crate_dirs.target}:/target:ro",
        "--workdir=/src",
        "--network=none",
        args.docker_image,
    ]
    env = [
        "/usr/bin/env",
        "-i",
        "CARGO_HOME=/cargo",
        "RUSTUP_HOME=/rustup",
        "PATH=/cargo/bin:/usr/bin",
    ]
    cargo = [
        "cargo",
        "metadata",
        "--locked",
        "--offline",
        "--no-deps",
        "--format-version=1",
    ]
    result = subprocess.run(
        docker + env + cargo,
        check=True,
        capture_output=True,
        text=True,
    )
    metadata = json.loads(result.stdout.strip())
    binaries = []
    for package in metadata["packages"]:
        for t in package["targets"]:
            if "bin" not in t["kind"]:
                continue
            if "bin" not in t["crate_types"]:
                continue
            binaries.append(t["name"])
    binaries.sort()
    return binaries


def tar_members_stripped(tar: TarFile):
    prefixes = []
    for member in tar.getmembers():
        path = Path(member.name)
        if member.isfile() and path.name == "Cargo.toml":
            prefixes.append(path.parent)
    if len(prefixes) == 0:
        raise Error("Failed to find `Cargo.toml` in the crate archive")
    prefixes.sort(key=lambda path: len(path.parts))
    prefix = prefixes[0]
    for member in tar.getmembers():
        member.name = str(Path(member.name).relative_to(prefix))
        yield member


class UrlInput:
    url: str
    hash: str

    def __init__(self, url: str, hash: str) -> None:
        self.url = url
        self.hash = hash

    def __lt__(self, other) -> bool:
        return (self.url, self.hash) < (other.url, other.hash)


class FileInput:
    path: str
    hash: str

    def __init__(self, path: str, hash: str) -> None:
        self.path = path
        self.hash = hash

    def __lt__(self, other) -> bool:
        return (self.path, self.hash) < (other.path, other.hash)


class Provenance:
    python: str
    rustup: UrlInput | None
    rustup_dir: str | None
    cargo_dir: str | None
    crates: list[UrlInput]
    binaries: list[FileInput]

    def __init__(self) -> None:
        self.python = python_hash()
        self.rustup = None
        self.rustup_dir = None
        self.cargo_dir = None
        self.crates = []
        self.binaries = []

    def to_json(self) -> str:
        json_object = {
            "python": self.python,
            "rustup": self.rustup.__dict__,
            "rustup_dir": self.rustup_dir,
            "cargo_dir": self.cargo_dir,
            "crates": [crate.__dict__ for crate in sorted(self.crates)],
            "binaries": [binary.__dict__ for binary in sorted(self.binaries)],
        }
        return json.dumps(json_object, sort_keys=True, separators=(",", ":"))


def python_hash() -> str:
    with open(sys.executable, "rb") as f:
        return pretty_blake2b(f.read())


def build_crates(args: Namespace) -> None:
    now = datetime.now(UTC)
    registry = cargo_registry_from_url(args.registry)
    target = rust_host_target_triple() if args.target is None else args.target
    provenance = Provenance()
    try:
        uid = os.getuid()
        gid = os.getgid()
    except AttributeError:
        uid = 0
        gid = 0
    if uid == 0:
        uid = 65534
        gid = 65534
    all_binaries = {}
    with tempfile.TemporaryDirectory(prefix="yard-") as workdir:
        workdirs = WorkDirs(Path(workdir).absolute())
        install_rust_toolchain(workdirs, uid, gid, target, args)
        provenance.rustup = UrlInput(
            get_rustup_init_url(args.rustup_dist_server, args.rustup_version, target),
            f"sha256:{args.rustup_hash}",
        )
        provenance.rustup_dir = hash_directory(workdirs.rustup)
        provenance.cargo_dir = hash_directory(workdirs.cargo)
        for crate in args.crates:
            candidate = find_installation_candidate(crate, registry, now, args)
            data = download_crate(candidate, crate.name, registry, args)
            provenance.crates.append(
                UrlInput(
                    registry.get_download_url(candidate), f"sha256:{candidate.cksum}"
                )
            )
            with tempfile.TemporaryDirectory(prefix="yard-crate-") as tmpdir:
                crate_dirs = CrateDirs(Path(tmpdir).absolute())
                with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tar:
                    tar.extractall(
                        members=tar_members_stripped(tar),
                        path=crate_dirs.src,
                        filter="data",
                    )
                cargo_fetch(workdirs, crate_dirs, uid, gid, target, args)
                cargo_build(workdirs, crate_dirs, uid, gid, target, args)
                binaries = cargo_metadata_binaries(workdirs, crate_dirs, uid, gid, args)
                for binary in binaries:
                    if binary in all_binaries:
                        raise Error(f"Duplicate binary name: {binary}")
                    binary_path = crate_dirs.target / target / args.profile / binary
                    with open(binary_path, "rb") as file:
                        contents = file.read()
                        all_binaries[binary] = contents
                        provenance.binaries.append(
                            FileInput(binary, pretty_blake2b(contents))
                        )
    sorted_binaries = sorted(all_binaries.items())
    archive_path = Path("archive.tar.gz")
    with (
        gzip.GzipFile(archive_path, "wb", mtime=0, compresslevel=9) as gzip_file,
        tarfile.open(fileobj=gzip_file, mode="w:") as tar,
    ):
        for file_name, contents in sorted_binaries:
            metadata = tarfile.TarInfo(name=file_name)
            metadata.mtime = 0
            metadata.mode = 0o755
            metadata.uid = 0
            metadata.gid = 0
            metadata.uname = "root"
            metadata.gname = "root"
            metadata.size = len(contents)
            if args.verbose:
                print(
                    f"Adding {colorize(file_name, Syntax.PATH)} to {colorize(archive_path.name, Syntax.NAME)}",
                    file=sys.stderr,
                )
            tar.addfile(metadata, fileobj=io.BytesIO(contents))
    with open("provenance.json", "w", encoding="utf-8") as f:
        f.write(provenance.to_json())


def main() -> None:
    try:
        args = parse_arguments()
        match args.subcommand:
            case "build":
                build_crates(args)
            case "generate":
                generate_archives(args)
            case "install":
                install_crates(args)
    except Exception as e:
        log_error(f"{e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
