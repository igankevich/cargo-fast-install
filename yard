def is_reserved_name(name: str) -> bool:
    def is_windows_reserved_file_name(name: str) -> bool:
        name_lower = name.lower()
        return any(name_lower.startswith(p) for p in WINDOWS_RESERVED_FILE_PREFIXES)

    def is_rust_keyword(name: str) -> bool:
        return any(name == keyword for keyword in RUST_KEYWORDS)

    return is_windows_reserved_file_name(name) or is_rust_keyword(name)


# https://doc.rust-lang.org/cargo/reference/manifest.html#the-name-field
def is_valid_crate_name(name: str) -> bool:
    @cache
    def crate_name_regex() -> Pattern[str]:
        return re.compile("[a-zA-Z0-9_-]{1,64}")

    return not is_reserved_name(name) and crate_name_regex().fullmatch(name) is not None


class CrateSpec:
    name: str
    version: str | None
    checksum: str | None

    def __init__(self, name: str, version: str | None, checksum: str | None) -> None:
        if not is_valid_crate_name(name):
            raise Error(f"Invalid crate name {colorize(name, Syntax.NAME)}")
        self.name = name
        self.version = version
        self.checksum = checksum

    def __str__(self) -> str:
        s = self.name
        if self.version is not None:
            s += "@"
            s += self.version
        elif self.checksum is not None:
            s += "@"
            s += self.checksum
        return s

    def __lt__(self, other) -> bool:
        return self.__str__() < other.__str__()


def parse_crate_spec(spec: str) -> CrateSpec:
    parts = [part.strip() for part in spec.split("@", 1)]
    if any(len(part) == 0 for part in parts):
        raise Error(
            f"Invalid crate spec: {colorize(spec, Syntax.NAME)}; "
            f"expected {colorize('NAME[@VERSION_OR_HASH]', Syntax.NAME)}"
        )
    if len(parts) == 2:
        name = parts[0]
        if is_sha256(parts[1]):
            checksum = parts[1]
            version = None
        else:
            version = parts[1]
            checksum = None
    else:
        name = spec
        version = None
        checksum = None
    return CrateSpec(name, version, checksum)


is_valid_binary_name = is_valid_crate_name


def is_valid_binary_variant(variant: str | None) -> bool:
    @cache
    def binary_variant_regex() -> Pattern[str]:
        return re.compile("[a-zA-Z0-9_-]{1,64}")

    if variant is None:
        return True
    return binary_variant_regex().fullmatch(variant) is not None


class BinarySpec:
    name: str
    variant: str | None

    def __init__(self, name: str, variant: str | None) -> None:
        if not is_valid_binary_name(name):
            raise Error(f"Invalid binary name {colorize(name, Syntax.NAME)}")
        if not is_valid_binary_variant(variant):
            raise Error(f"Invalid binary variant {colorize(variant, Syntax.NAME)}")
        self.name = name
        self.variant = variant

    def __str__(self) -> str:
        s = self.name
        if self.variant is not None:
            s += ":"
            s += self.variant
        return s

    def __repr__(self) -> str:
        return self.__str__()

    def __hash__(self) -> int:
        return hash((self.name, self.variant))

    def __eq__(self, other) -> bool:
        return (self.name, self.variant) == (other.name, other.variant)

    def __lt__(self, other) -> bool:
        return self.__str__() < other.__str__()


def parse_binary_spec(spec: str) -> BinarySpec:
    parts = spec.split(":", 1)
    if any(len(part) == 0 for part in parts):
        raise Error(
            f"Invalid binary spec: {colorize(spec, Syntax.NAME)}; "
            f"expected {colorize('NAME[:VARIANT]', Syntax.NAME)}"
        )
    if len(parts) == 2:
        name = parts[0]
        variant = parts[1]
    else:
        name = spec
        variant = None
    return BinarySpec(name, variant)


class ArchiveSpec:
    target: str
    hash: str
    url: str
    binaries: set[BinarySpec]
    variant: str | None
    crate: SimpleNamespace | None

    def __init__(
        self,
        target: str,
        hash: str,
        url: str,
        binaries: set[BinarySpec],
        crate: SimpleNamespace | None,
    ) -> None:
        if len(binaries) == 0:
            raise Error("Archive with no binaries is not allowed")
        if not is_blake2b(hash):
            raise Error(
                f"Archive hash has invalid format: {colorize(hash, Syntax.HASH)}"
            )
        variants = set()
        variant = None
        for binary in binaries:
            variants.add(binary.variant)
            variant = binary.variant
        if len(variants) > 1:
            raise Error(
                f"Only one binary variant per archive is allowed; "
                f"got {', '.join(colorize(variants, Syntax.NAME))}"
            )
        self.target = target
        self.hash = hash
        self.url = url
        self.binaries = binaries
        self.crate = crate
        self.variant = variant

    def to_json(self) -> str:
        json_object = {
            "target": self.target,
            "binaries": sorted([binary.name for binary in self.binaries]),
            "url": self.url,
            "hash": self.hash,
        }
        if self.variant is not None:
            json_object["variant"] = self.variant
        return json.dumps(json_object, sort_keys=True, separators=(",", ":"))


def parse_archive_spec(
    json_object: dict[str, object], crate: SimpleNamespace
) -> ArchiveSpec:
    def get_string(json_object: dict[str, object], key: str) -> str:
        value = json_object.get(key)
        if not isinstance(value, str):
            raise Error(f"Invalid archive spec: value under `{key}` is not a string")
        return value

    def get_optinoal_string(json_object: dict[str, object], key: str) -> str | None:
        value = json_object.get(key)
        if value is not None and not isinstance(value, str):
            raise Error(f"Invalid archive spec: value under `{key}` is not a string")
        return value

    def get_string_list(json_object: dict[str, object], key: str) -> list[str]:
        value = json_object.get(key)
        if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
            raise Error(
                f"Invalid archive spec: value under `{key}` is not a list of strings"
            )
        return value

    variant = get_optinoal_string(json_object, "variant")
    return ArchiveSpec(
        binaries={
            BinarySpec(name, variant=variant)
            for name in sorted(get_string_list(json_object, "binaries"))
        },
        target=get_string(json_object, "target"),
        hash=get_string(json_object, "hash"),
        url=get_string(json_object, "url"),
        crate=crate,
    )


def blake2b(data: bytes) -> str:
    return hashlib.blake2b(data).hexdigest()[:64]


def pretty_blake2b(data: bytes) -> str:
    return f"b2:{hashlib.blake2b(data).hexdigest()}"


def is_blake2b(s: str) -> bool:
    return len(s) == 64 and all(ch in string.hexdigits for ch in s)


def is_sha256(s: str) -> bool:
    return len(s) == 64 and all(ch in string.hexdigits for ch in s)


def hash_directory(root: Path) -> str:
    def h(tag: bytes, data: bytes) -> bytes:
        hasher = hashlib.blake2b()
        hasher.update(tag)
        hasher.update(data)
        return hasher.digest()

    # Find all files.
    paths = []
    for dir, subdirs, files in os.walk(root):
        prefix = Path(dir).relative_to(root)
        for name in subdirs:
            paths.append((0, prefix / name))
        for name in files:
            paths.append((1, prefix / name))
    paths.sort()
    # Compute file hashes.
    hash = hashlib.blake2b(b"").digest()
    for i, (kind, path) in enumerate(paths):
        h0 = h(b"kind", kind.to_bytes(1, byteorder="little"))
        h1 = h(b"index", i.to_bytes(4, byteorder="little"))
        h2 = h(b"path", str(path).encode("utf-8"))
        x = h(h(h0, h1), h2)
        match kind:
            case 1:
                with open(root / path, "rb") as f:
                    data = f.read()
                h3 = h(b"contents", data)
                y = h(x, h3)
            case _:
                y = x
        hash = h(hash, y)
    return f"b2/dir:{hash.hex()}"


def fetch_registry_config(base_url: str) -> str:
    config_url = f"{base_url}/config.json"
    try:
        with urllib.request.urlopen(create_http_request(config_url)) as response:
            data = response.read().decode("utf-8")
            config = json.loads(data, object_hook=lambda d: SimpleNamespace(**d))
            if not hasattr(config, "dl"):
                raise Error(f"{colorize(config_url, Syntax.URL)} doesn't have `dl` key")
    except Exception as e:
        raise Error(
            f"Failed to fetch registry configuration from {colorize(config_url, Syntax.URL)}: {e}"
        ) from e
    return config.dl


class CargoRegistry:
    base_url: str
    dl: str

    def __init__(self, base_url: str, dl: str) -> None:
        self.base_url = base_url
        self.dl = dl

    def get_metadata_url(self, crate_name: str) -> str:
        return f"{self.base_url}/{get_crate_prefix(crate_name)}"

    def get_download_url(self, crate: SimpleNamespace) -> str:
        # https://doc.rust-lang.org/cargo/reference/registry-index.html
        prefix = get_crate_prefix(crate.name)
        markers = {
            "crate": crate.name,
            "version": crate.vers,
            "prefix": prefix,
            "lowerprefix": prefix.lower(),
            "sha256-checksum": crate.cksum,
        }
        pattern = re.compile("\\{([a-z0-9-]+)\\}")
        matches = pattern.finditer(self.dl)
        url = self.dl
        matched = False
        for match in reversed(list(matches)):
            value = markers.get(match.group(1))
            if value is not None:
                matched = True
                url = url[: match.start(0)] + value + url[match.end(0) :]
        if not matched:
            url += f"/{crate.name}/{crate.vers}/download"
        return url


def cargo_registry_from_url(base_url: str) -> CargoRegistry:
    dl = fetch_registry_config(base_url)
    return CargoRegistry(base_url, dl)


def get_crate_prefix(name: str) -> str:
    match len(name):
        case 0:
            raise Error("Empty crate name")
        case 1:
            return f"1/{name}"
        case 2:
            return f"2/{name}"
        case 3:
            return f"3/{name[0]}/{name}"
        case _:
            return f"{name[:2]}/{name[2:4]}/{name}"


def is_config_file(path: Path) -> bool:
    return (
        not path.is_absolute() and len(path.parts) == 2 and path.name == REPO_FILE_NAME
    )


def guess_rust_host_target_triple() -> str:
    def rust_arch() -> str:
        match platform.machine().lower():
            case "amd64" | "x86_64":
                return "x86_64"
            case "arm64" | "aarch64":
                return "aarch64"
            case arch:
                return arch

    arch = rust_arch()
    match platform.system().lower():
        case "linux":
            libc, _ = platform.libc_ver()
            env = "gnu" if libc == "glibc" else "musl"
            return f"{arch}-unknown-linux-{env}"
        case "darwin":
            return f"{arch}-apple-darwin"
        case "windows":
            env = "gnu" if "mingw" in sys.version.lower() else "msvc"
            return f"{arch}-pc-windows-{env}"
        case system:
            return f"{arch}-unknown-{system}"


def rust_host_target_triple() -> str:
    try:
        result = subprocess.run(
            ["rustc", "--print", "host-tuple"],
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except Exception:
        return guess_rust_host_target_triple()


def get_cargo_home() -> Path:
    cargo_home_str = os.environ.get("CARGO_HOME", None)
    if cargo_home_str is None:
        home_str = os.environ.get("HOME", None)
        if home_str is None:
            home = Path.home()
        else:
            home = Path(home_str)
        cargo_home = home / ".cargo"
    else:
        cargo_home = Path(cargo_home_str)
    return cargo_home


def parse_duration(s: str) -> timedelta:
    s = s.strip()
    if s.endswith("d"):
        s = s[:-1].strip()
    return timedelta(days=int(s))


@cache
def get_script_hash() -> str:
    with open(sys.argv[0], "rb") as file:
        return blake2b(file.read())


class Syntax(Enum):
    NAME = 0
    URL = 1
    PATH = 2
    HASH = 3
    ERROR = 4
    VERSION = 5
    WARNING = 6
    CODE = 7


def colorize(text: object, kind: Syntax) -> str:
    if not sys.stderr.isatty() and os.environ.get("CI") is None:
        return str(text)
    match kind:
        case Syntax.NAME | Syntax.URL | Syntax.PATH | Syntax.HASH | Syntax.VERSION:
            return f"\x1b[34m{text}\x1b[0m"
        case Syntax.ERROR:
            return f"\x1b[1;31m{text}\x1b[0m"
        case Syntax.WARNING:
            return f"\x1b[1;33m{text}\x1b[0m"
        case Syntax.CODE:
            return f"\x1b[1;35m{text}\x1b[0m"
        case _:
            return str(text)


def log_error(message: str) -> None:
    print(f"{colorize('Error: ', Syntax.ERROR)}{message}", file=sys.stderr)


def log_warning(message: str) -> None:
    print(f"{colorize('Warning: ', Syntax.WARNING)}{message}", file=sys.stderr)


def get_user_agent() -> str:
    version = get_script_hash()[:8]
    return f"yard/{version}"


def create_http_request(url: str) -> Request:
    return urllib.request.Request(
        url, headers={"User-Agent": get_user_agent()}, method="GET"
    )


