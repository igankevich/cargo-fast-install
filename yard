def cargo_metadata_binaries(workdirs, crate_dirs, uid, gid, args):
    docker = [
        "docker",
        "run",
        "--rm",
        f"--user={uid}:{gid}",
        f"--volume={workdirs.cargo}:/cargo:ro",
        f"--volume={workdirs.rustup}:/rustup:ro",
        f"--volume={crate_dirs.src}:/src:ro",
        f"--volume={crate_dirs.target}:/target:ro",
        "--workdir=/src",
        "--network=none",
        args.docker_image,
    ]
    env = [
        "/usr/bin/env",
        "-i",
        "CARGO_HOME=/cargo",
        "RUSTUP_HOME=/rustup",
        "PATH=/cargo/bin:/usr/bin",
    ]
    cargo = [
        "cargo",
        "metadata",
        "--locked",
        "--offline",
        "--no-deps",
        "--format-version=1",
    ]
    result = subprocess.run(
        docker + env + cargo,
        check=True,
        capture_output=True,
        text=True,
    )
    metadata = json.loads(result.stdout.strip())
    binaries = []
    for package in metadata["packages"]:
        for t in package["targets"]:
            if "bin" not in t["kind"]:
                continue
            if "bin" not in t["crate_types"]:
                continue
            binaries.append(t["name"])
    binaries.sort()
    return binaries


def tar_members_stripped(tar):
    prefixes = []
    for member in tar.getmembers():
        path = Path(member.path)
        if member.isfile() and path.name == "Cargo.toml":
            prefixes.append(path.parent)
    if len(prefixes) == 0:
        raise Error("Failed to find `Cargo.toml` in the crate archive")
    prefixes.sort(key=lambda path: len(path.parts))
    prefix = prefixes[0]
    for member in tar.getmembers():
        member.path = str(Path(member.path).relative_to(prefix))
        yield member


def build_crates(args):
    now = datetime.now(UTC)
    registry = CargoRegistry(args.registry)
    target = rust_host_target_triple() if args.target is None else args.target
    try:
        uid = os.getuid()
        gid = os.getgid()
    except AttributeError:
        uid = 0
        gid = 0
    if uid == 0:
        uid = 65534
        gid = 65534
    all_binaries = {}
    with tempfile.TemporaryDirectory(prefix="yard-") as workdir:
        workdirs = WorkDirs(Path(workdir).absolute())
        install_rust_toolchain(workdirs, uid, gid, target, registry, args)
        for crate in args.crates:
            candidate = find_installation_candidate(crate, registry, now, args)
            data = download_crate(candidate, crate.name, registry, args)
            with tempfile.TemporaryDirectory(prefix="yard-crate-") as tmpdir:
                crate_dirs = CrateDirs(Path(tmpdir).absolute())
                with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tar:
                    tar.extractall(
                        members=tar_members_stripped(tar),
                        path=crate_dirs.src,
                        filter="data",
                    )
                cargo_fetch(workdirs, crate_dirs, uid, gid, target, args)
                cargo_build(workdirs, crate_dirs, uid, gid, target, args)
                binaries = cargo_metadata_binaries(workdirs, crate_dirs, uid, gid, args)
                for binary in binaries:
                    if binary in all_binaries:
                        raise Error(f"Duplicate binary name: {binary}")
                    binary_path = crate_dirs.target / target / args.profile / binary
                    with open(binary_path, "rb") as file:
                        all_binaries[binary] = file.read()
    sorted_binaries = sorted(all_binaries.items())
    archive_path = Path("archive.tar.gz")
    with (
        gzip.GzipFile(archive_path, "wb", mtime=0, compresslevel=9) as gzip_file,
        tarfile.open(fileobj=gzip_file, mode="w:") as tar,
    ):
        for file_name, contents in sorted_binaries:
            metadata = tarfile.TarInfo(name=file_name)
            metadata.mtime = 0
            metadata.mode = 0o755
            metadata.uid = 0
            metadata.gid = 0
            metadata.uname = "root"
            metadata.gname = "root"
            metadata.size = len(contents)
            if args.verbose:
                print(
                    f"Adding {colorize(file_name, Syntax.PATH)} to {colorize(archive_path.name, Syntax.NAME)}",
                    file=sys.stderr,
                )
            tar.addfile(metadata, fileobj=io.BytesIO(contents))


def main():
    try:
        args = parse_arguments()
        match args.subcommand:
            case "build":
                build_crates(args)
            case "generate":
                generate_archives(args)
            case "install":
                install_crates(args)
    except Exception as e:
        log_error(f"{e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
